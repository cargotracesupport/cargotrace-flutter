# Google Maps key for the mobile app. NOT committed as a real value.
# Android: put `googleMapsKey=AIza...` in android/local.properties (gitignored),
#          or export GOOGLE_MAPS_KEY in the build environment.
# iOS:     put the key in ios/Flutter/Secrets.xcconfig (gitignored) as
#          GOOGLE_MAPS_KEY = AIza...
# Dart:    pass the SAME key so the app knows a map can render:
#          flutter run --dart-define=GOOGLE_MAPS_KEY=AIza...
GOOGLE_MAPS_KEY=
